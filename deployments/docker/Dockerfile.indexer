FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/search-indexer ./cmd/search-indexer

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/search-indexer /search-indexer
USER nonroot:nonroot
EXPOSE 9092
ENTRYPOINT ["/search-indexer"]
