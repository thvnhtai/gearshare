# Builds the LOCAL WORKER entrypoint (main_worker.go) by default — the
# variant that runs as a long-lived container in docker-compose/k8s.
# The Lambda entrypoint (main_lambda.go, build tag `lambda`) is meant to be
# built and zipped for a real AWS deployment, not containerized:
#   GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build -tags lambda -o bootstrap ./cmd/thumbnail-fn
# then zip `bootstrap` for a `provided.al2023` Lambda function.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/thumbnail-fn ./cmd/thumbnail-fn

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/thumbnail-fn /thumbnail-fn
USER nonroot:nonroot
ENTRYPOINT ["/thumbnail-fn"]
