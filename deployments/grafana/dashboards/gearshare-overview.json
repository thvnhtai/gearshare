{
  "title": "GearShare Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests/sec by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(gearshare_http_requests_total[1m])) by (path)",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 request latency by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(gearshare_http_request_duration_seconds_bucket[5m])) by (le, path))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP error rate (5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(gearshare_http_requests_total{status=~\"5..\"}[1m]))",
          "legendFormat": "5xx/sec"
        }
      ]
    },
    {
      "id": 4,
      "title": "Booking transaction deadlock/lock-wait retries",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(gearshare_booking_tx_retries_total[5m])",
          "legendFormat": "retries/sec"
        }
      ]
    },
    {
      "id": 5,
      "title": "Circuit breaker state (0=closed 1=half-open 2=open)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "gearshare_circuit_breaker_state",
          "legendFormat": "{{breaker}}"
        }
      ]
    }
  ]
}
