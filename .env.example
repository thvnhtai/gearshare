APP_ENV=development

HTTP_ADDR=:8080
GRPC_ADDR=:9090
CORS_ORIGIN=http://localhost:8081

MYSQL_PRIMARY_DSN=gearshare_app:app_password@tcp(127.0.0.1:3306)/gearshare?parseTime=true&multiStatements=true
MYSQL_REPLICA_DSN=gearshare_app:app_password@tcp(127.0.0.1:3307)/gearshare?parseTime=true&multiStatements=true

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=gearshare

KAFKA_BROKERS=127.0.0.1:9092
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
ELASTICSEARCH_ADDR=http://127.0.0.1:9200

# Generate a real random secret for anything beyond local dev.
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
BCRYPT_COST=12
API_KEY_PEPPER=dev-only-change-me
SESSION_SECRET=dev-only-change-me

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback

SAML_CERT_PATH=deployments/idp/saml/sp.crt
SAML_KEY_PATH=deployments/idp/saml/sp.key
SAML_IDP_METADATA_URL=

OTEL_SERVICE_NAME=gearshare-api
OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:4318
OTEL_ENABLED=true
